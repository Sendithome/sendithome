{
  "name": "HotelOnboardingStatus",
  "type": "object",
  "properties": {
    "hotel_id": {
      "type": "string",
      "description": "Reference to Hotel entity"
    },
    "application_id": {
      "type": "string",
      "description": "Reference to HotelApplication entity"
    },
    "user_email": {
      "type": "string"
    },
    "hotel_name": {
      "type": "string"
    },
    "logistics_stage": {
      "type": "string",
      "enum": [
        "pending_dispatch",
        "dispatched_to_logistics",
        "logistics_contacted",
        "site_visit_scheduled",
        "site_visit_done",
        "materials_delivered",
        "fully_onboarded"
      ],
      "default": "pending_dispatch",
      "description": "Current logistics onboarding stage"
    },
    "qr_approved_at": {
      "type": "string",
      "description": "ISO timestamp when QR was approved"
    },
    "dispatched_at": {
      "type": "string",
      "description": "ISO timestamp when admin dispatched to logistics"
    },
    "target_completion_date": {
      "type": "string",
      "description": "Target date for full onboarding (10 working days from dispatch)"
    },
    "logistics_notes": {
      "type": "string",
      "description": "Admin/logistics implementation notes"
    },
    "stage_updated_at": {
      "type": "string",
      "description": "ISO timestamp of last stage update"
    },
    "stage_updated_by": {
      "type": "string",
      "description": "Email of who updated the stage"
    },
    "outstanding_tasks": {
      "type": "array",
      "description": "Checklist of outstanding onboarding tasks",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          },
          "created_at": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "communication_log": {
      "type": "array",
      "description": "Chronological log of communications with the hotel / courier",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "whatsapp",
              "in_person",
              "note"
            ],
            "default": "note"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  "required": [
    "user_email"
  ]
}