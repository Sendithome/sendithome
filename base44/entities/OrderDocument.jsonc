{
  "name": "OrderDocument",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to Order"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "commercial_invoice",
        "packing_list",
        "customs_declaration",
        "receipt",
        "other"
      ],
      "default": "other"
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "file_url",
    "doc_type"
  ]
}