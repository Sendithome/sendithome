{
  "name": "OrderItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to Order"
    },
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "eligible": {
      "type": "boolean",
      "default": true
    },
    "ineligible_reason": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "item_name"
  ]
}