{
  "name": "Retailer",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "description": "Legal registered store name (as on trade license)"
    },
    "brand_name": {
      "type": "string",
      "description": "Brand name as it appears on shopping receipts (e.g. Gucci, Prada, Nike)"
    },
    "store_location": {
      "type": "string"
    },
    "trade_license_number": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "store_category": {
      "type": "string",
      "enum": [
        "Fashion",
        "Footwear",
        "Bags & Accessories",
        "Sportswear",
        "Souvenirs & Gifts",
        "Toys",
        "Baby & Kids",
        "Department Store",
        "Other"
      ]
    },
    "branches_count": {
      "type": "number",
      "default": 1
    },
    "trade_license_url": {
      "type": "string"
    },
    "partner_code": {
      "type": "string",
      "description": "Unique retailer partner code e.g. RTL-00123"
    },
    "login_password": {
      "type": "string",
      "description": "Auto-generated login password sent to retailer on approval"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "commission_rate": {
      "type": "number",
      "default": 2.5,
      "description": "Commission percentage"
    },
    "notification_preference": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "default": "email"
    },
    "user_email": {
      "type": "string",
      "description": "Linked user account email"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes about this retailer"
    },
    "approved_at": {
      "type": "string",
      "description": "ISO timestamp of approval"
    },
    "approved_by": {
      "type": "string",
      "description": "Admin email who approved"
    },
    "reject_reason": {
      "type": "string",
      "description": "Reason given for rejection"
    },
    "credentials_resent_at": {
      "type": "string",
      "description": "ISO timestamp of last credentials resend"
    },
    "approval_history": {
      "type": "array",
      "description": "Chronological log of admin actions on this retailer",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "store_name",
    "contact_email"
  ]
}