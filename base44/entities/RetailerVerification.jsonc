{
  "name": "RetailerVerification",
  "type": "object",
  "properties": {
    "shipment_id": {
      "type": "string",
      "description": "e.g. SIH-2026-00123"
    },
    "order_id": {
      "type": "string",
      "description": "Reference to the Order entity"
    },
    "retailer_id": {
      "type": "string"
    },
    "retailer_email": {
      "type": "string"
    },
    "store_name": {
      "type": "string",
      "description": "Store name as extracted from receipt"
    },
    "tourist_name": {
      "type": "string"
    },
    "tourist_passport_country": {
      "type": "string"
    },
    "tourist_country_group": {
      "type": "string",
      "enum": [
        "preferred",
        "row"
      ],
      "description": "Commission country group: preferred (GCC, India, Egypt, Jordan, Russia) or row (Rest of World)"
    },
    "hotel_name": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "description": "Shopping receipt image URL"
    },
    "passport_url": {
      "type": "string",
      "description": "Tourist passport copy image URL"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "hs_code": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "eligible": {
            "type": "boolean"
          }
        }
      }
    },
    "total_value": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "commission_tier": {
      "type": "number",
      "description": "Tier number (1-8 for preferred, 1-7 for ROW)"
    },
    "commission_rate": {
      "type": "number",
      "description": "e.g. 0.10 for 10%"
    },
    "destination_country": {
      "type": "string"
    },
    "customs_ref": {
      "type": "string"
    },
    "shipment_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "queried",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "deadline_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 24h after creation"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "query_reason": {
      "type": "string"
    },
    "query_type": {
      "type": "string"
    },
    "query_submitted_at": {
      "type": "string"
    }
  },
  "required": [
    "shipment_id",
    "retailer_id"
  ]
}