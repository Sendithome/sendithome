{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "receipt_uploaded",
        "payment_pending",
        "paid",
        "packed",
        "picked_up",
        "in_transit",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "box_size": {
      "type": "string",
      "enum": [
        "10kg",
        "20kg"
      ]
    },
    "price": {
      "type": "number",
      "default": 60
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "passport_number": {
      "type": "string",
      "description": "Sender passport number"
    },
    "nationality": {
      "type": "string",
      "description": "Sender nationality"
    },
    "passport_expiry": {
      "type": "string",
      "description": "Sender passport expiry date"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender email address"
    },
    "sender_phone": {
      "type": "string",
      "description": "Sender primary phone number"
    },
    "sender_alternate_phone": {
      "type": "string",
      "description": "Sender alternate contact / WhatsApp"
    },
    "hotel_name": {
      "type": "string"
    },
    "hotel_room": {
      "type": "string"
    },
    "hotel_city": {
      "type": "string"
    },
    "hotel_country": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "destination_address": {
      "type": "string"
    },
    "destination_city": {
      "type": "string"
    },
    "destination_postal_code": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_phone": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "description": "Receiver email address"
    },
    "recipient_nationality": {
      "type": "string",
      "description": "Receiver nationality"
    },
    "recipient_passport_number": {
      "type": "string",
      "description": "Receiver passport number (if applicable)"
    },
    "recipient_alternate_phone": {
      "type": "string",
      "description": "Receiver alternate contact number"
    },
    "tracking_number": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "estimated_delivery": {
      "type": "string"
    },
    "items_count": {
      "type": "number",
      "default": 0
    },
    "qr_code_id": {
      "type": "string"
    },
    "multi_retailer_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending_retailer_approvals",
        "all_retailers_approved",
        "consolidated"
      ],
      "default": "not_applicable",
      "description": "Tracks multi-store verification workflow"
    },
    "retailer_verifications_count": {
      "type": "number",
      "default": 0
    },
    "retailer_verifications_approved": {
      "type": "number",
      "default": 0
    },
    "consolidated_at": {
      "type": "string"
    },
    "consolidated_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "store_name": {
            "type": "string"
          },
          "retailer_id": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "eligible": {
            "type": "boolean"
          }
        }
      }
    },
    "consolidated_total_value": {
      "type": "number"
    },
    "consolidated_customs_ref": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string",
      "description": "Primary SIH shipment ID e.g. SIH-2026-00123"
    }
  },
  "required": [
    "destination_country"
  ]
}