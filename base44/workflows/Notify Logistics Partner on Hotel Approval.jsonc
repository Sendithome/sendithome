{
  "name": "Notify Logistics Partner on Hotel Approval",
  "description": "Fires when a HotelApplication status changes to 'approved'. Sends an email to the logistics partner with hotel details and QR URL.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "HotelApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_logistics_partner_on_hotel_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyHotelApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyHotelApproval"
  }
}